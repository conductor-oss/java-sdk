<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.netflix.conductor.client.automator.AdaptiveConcurrencyController"
            level="${E2E_CONTROLLER_LOG_LEVEL:-INFO}" />

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
